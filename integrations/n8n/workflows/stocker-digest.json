          {
            "node": "Notify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run on demand": {
      "main": [
        [
          {
            "node": "review.queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }

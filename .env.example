# Stocker configuration
# Секреты сюда НЕ записывать.
# Реальные значения будут храниться в .env

STOCKER_ROOT=F:/stock/stocker

# LM Studio (LocalAnalyzer). Если не заданы — используются значения по умолчанию из кода.
# LMSTUDIO_BASE_URL=http://192.168.1.104:1234/v1
# LMSTUDIO_MODEL=qwen3-vl-8b-instruct
# LMSTUDIO_API_KEY=lm-studio
# LMSTUDIO_TIMEOUT=180

# Metadata AI (отдельная роль от Vision). Если не заданы — значения по умолчанию из кода.
# METADATA_BASE_URL=http://192.168.1.104:1234/v1
# METADATA_MODEL=qwen3-vl-8b-instruct
# METADATA_API_KEY=lm-studio
# METADATA_TIMEOUT=180
